# One-day demo mode: no real secrets here.
DB_PATH=/app/data/demo.db
PUBLIC_BACKEND_URL=http://localhost:8000
CHAIRMAN_VIDEO_URL=https://youtu.be/1POsZtDks5M?si=hfk-k3mt-l0L-O6O

# If you connect real Bitrix, put values only in .env, never in repo.
MOCK_BITRIX=true
BITRIX_WEBHOOK_BASE_URL=https://your-bitrix/rest/1/your-token
BITRIX_BOT_ID=
HR_USER_ID=1

# Task reminder threshold for demo: send reminder if deadline is within N hours.
DEMO_SOON_THRESHOLD_HOURS=2

# RAG / ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=kmg_vnd_documents
VND_DOCS_DIR=/app/seed_data/vnd_docs
RAG_TOP_K=5
RAG_EMBEDDING_DIM=384
FORCE_RAG_REINDEX=false
